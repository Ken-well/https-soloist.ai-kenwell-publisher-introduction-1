#!/bin/bash

################################################################################
# Software Build Documentation Script
# Purpose: Automate documentation building and deployment
# Usage: ./kenwell/bin/bash [command] [options]
################################################################################

set -euo pipefail

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

################################################################################
# Logging Functions
################################################################################

log_info() {
    echo -e "${BLUE}[INFO]${NC} $*"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $*"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $*"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $*" >&2
}

################################################################################
# Build Functions
################################################################################

build_documentation() {
    log_info "Starting documentation build..."
    
    if [ ! -d "$PROJECT_ROOT" ]; then
        log_error "Project root directory not found: $PROJECT_ROOT"
        return 1
    fi
    
    cd "$PROJECT_ROOT"
    
    # Check for documentation tools
    if command -v mkdocs &> /dev/null; then
        log_info "Building with MkDocs..."
        mkdocs build
    elif command -v sphinx-build &> /dev/null; then
        log_info "Building with Sphinx..."
        sphinx-build -b html docs docs/_build/html
    else
        log_warning "No documentation tool found (MkDocs or Sphinx)"
        log_info "Skipping documentation build"
        return 0
    fi
    
    log_success "Documentation build completed"
}

serve_documentation() {
    log_info "Starting documentation server..."
    
    cd "$PROJECT_ROOT"
    
    if command -v mkdocs &> /dev/null; then
        log_info "Serving with MkDocs on http://localhost:8000"
        mkdocs serve
    elif command -v python3 &> /dev/null; then
        log_info "Serving with Python HTTP server on http://localhost:8000"
        cd docs/_build/html 2>/dev/null || cd docs 2>/dev/null || cd .
        python3 -m http.server 8000
    else
        log_error "No suitable server found"
        return 1
    fi
}

clean_documentation() {
    log_info "Cleaning documentation build artifacts..."
    
    cd "$PROJECT_ROOT"
    
    rm -rf docs/_build/ 2>/dev/null || true
    rm -rf site/ 2>/dev/null || true
    rm -rf .mkdocs_cache/ 2>/dev/null || true
    
    log_success "Documentation cleaned"
}

validate_documentation() {
    log_info "Validating documentation..."
    
    cd "$PROJECT_ROOT"
    
    if [ -f "mkdocs.yml" ] || [ -f "docs/conf.py" ]; then
        log_success "Documentation configuration found"
        return 0
    else
        log_warning "No documentation configuration found"
        return 1
    fi
}

install_dependencies() {
    log_info "Installing documentation dependencies..."
    
    if [ -f "$PROJECT_ROOT/requirements.txt" ]; then
        if command -v pip &> /dev/null; then
            pip install -r "$PROJECT_ROOT/requirements.txt"
            log_success "Dependencies installed"
        else
            log_error "pip not found"
            return 1
        fi
    else
        log_warning "requirements.txt not found"
    fi
}

################################################################################
# Help Function
################################################################################

show_help() {
    cat << EOF
${BLUE}Documentation Software Build Script${NC}

${GREEN}Usage:${NC}
    $0 [command] [options]

${GREEN}Commands:${NC}
    build       Build documentation
    serve       Serve documentation locally
    clean       Clean build artifacts
    validate    Validate documentation configuration
    install     Install dependencies
    help        Show this help message

${GREEN}Examples:${NC}
    $0 build
    $0 serve
    $0 clean
    $0 validate

${GREEN}Environment Variables:${NC}
    PROJECT_ROOT    Override project root directory (default: repository root)

${BLUE}For more information, visit the documentation.${NC}
EOF
}

################################################################################
# Main Script
################################################################################

main() {
    local command="${1:-help}"
    
    case "$command" in
        build)
            build_documentation
            ;;
        serve)
            serve_documentation
            ;;
        clean)
            clean_documentation
            ;;
        validate)
            validate_documentation
            ;;
        install)
            install_dependencies
            ;;
        help|--help|-h)
            show_help
            ;;
        *)
            log_error "Unknown command: $command"
            echo ""
            show_help
            exit 1
            ;;
    esac
}

# Run main function with all arguments
main "$@"
